<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>termcity</AssemblyName>
    <RootNamespace>TermCity.App</RootNamespace>
    <!-- Steady frame times matter more than peak throughput: no profiling instrumentation in the first seconds, and no
         background garbage collection thread. -->
    <TieredPGO>false</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TermCity.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TermCity.Core\TermCity.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
  </ItemGroup>

</Project>
