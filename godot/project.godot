config_version=5

[application]
config/name="TermCity Godot"
config/version="0.1.0"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="TermCityGodot"

[display]
window/size/viewport_width=1200
window/size/viewport_height=720
window/size/window_width_override=1200
window/size/window_height_override=720
window/size/min_width=640
window/size/min_height=480

[dotnet]
project/assembly_name="TermCity.Godot"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
